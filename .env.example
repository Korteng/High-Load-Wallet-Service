# Copy to .env (never commit .env) and fill in
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=
# comma-separated chat ids allowed to use the bot; empty = everyone who finds the bot
TELEGRAM_ALLOWED_CHAT_IDS=

# LLM categorization of operations the keyword classifier cannot place (GigaChat, personal scope)
LLM_ENABLED=false
# Authorization key from the GigaChat API cabinet (base64 of client_id:client_secret). Never commit it.
GIGACHAT_AUTH_KEY=

# Database password. Set it before the FIRST start on a new machine (an existing volume keeps its old password).
DB_PASSWORD=
